# Local environment variables for SiteAtlas.
# Copy this file to .env.local before running the app.

NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required by /api/admin/sync. Replace this local-only value in deployed environments.
ADMIN_SYNC_TOKEN=local-siteatlas-sync-token
